{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/node",
    "rootDir": ".",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node", "vite/client"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/locales/*.json",
    "src/notices/**/*.ts",
    "src/csp/**/*.ts",
    // The keymap, the shortcut map, the tool list and the top bar's menus are
    // plain data, compiled here too so src/main/shortcuts.test.ts can hold the
    // map to the menus and the main process's keys (8.2, 8.7, U.3).
    "src/renderer/src/keymap.ts",
    "src/renderer/src/menus.ts",
    "src/renderer/src/shortcuts.ts",
    "src/renderer/src/tools.ts",
    "electron.vite.config.ts"
  ],
  "references": [{ "path": "../../packages/platform" }, { "path": "../../packages/persist" }]
}
