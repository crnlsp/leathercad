{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/node",
    "rootDir": ".",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/notices/**/*.ts",
    "src/csp/**/*.ts",
    // The shortcut map and the tool list are plain data, compiled here too so
    // src/main/shortcuts.test.ts can hold the map to the menu (8.2).
    "src/renderer/src/shortcuts.ts",
    "src/renderer/src/tools.ts",
    "electron.vite.config.ts"
  ],
  "references": [{ "path": "../../packages/platform" }]
}
