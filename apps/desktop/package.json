{
  "name": "@leathercad/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Electron shell for LeatherCAD",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --build",
    "package": "electron-vite build && electron-builder --config electron-builder.config.mjs --linux AppImage",
    "package:dir": "electron-vite build && electron-builder --config electron-builder.config.mjs --linux dir",
    "package:e2e": "LEATHERCAD_PACKAGE_FOR_E2E=1 pnpm run package:dir",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@leathercad/core": "workspace:*",
    "@leathercad/document": "workspace:*",
    "@leathercad/domain": "workspace:*",
    "@leathercad/editor": "workspace:*",
    "@leathercad/export": "workspace:*",
    "@leathercad/geometry": "workspace:*",
    "@leathercad/persist": "workspace:*",
    "@leathercad/platform": "workspace:*",
    "@leathercad/render": "workspace:*",
    "@leathercad/typography": "workspace:*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "electron-vite": "^5.0.0",
    "lucide-react": "1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2"
  },
  "productName": "LeatherCAD",
  "desktopName": "leathercad.desktop",
  "author": "cornelisp",
  "license": "Apache-2.0",
  "homepage": "https://github.com/cornelisp/leathercad"
}
