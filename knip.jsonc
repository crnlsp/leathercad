// Dead code, unused dependencies and unlisted binaries. See ADR 0016.
//
// Every ignore below is either deliberate or a recorded finding, and says which.
// A finding is listed so that CI ratchets: nothing new may join it, and removing
// one is a decision for the owner, not a side effect of adding the tool.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  "workspaces": {
    ".": {
      // Run by tools/visual.mjs, which knip cannot follow into a container.
      "entry": ["playwright.visual.config.ts", "tools/*.mjs"],
    },
    "apps/desktop": {
      // Passed to electron-builder with --config.
      "entry": ["electron-builder.config.mjs"],
    },
  },

  // Constants such as MIN_HOLE_EDGE_CLEARANCE_MM are exported so tests and docs
  // can name them. Exporting a value its own file uses is not dead code.
  "ignoreExportsUsedInFile": true,

  // System tools the tests shell out to. poppler is required in CI
  // (LEATHERCAD_REQUIRE_POPPLER); graphviz only by `pnpm depcruise:graph`.
  "ignoreBinaries": ["pdfinfo", "pdftoppm", "dot"],

  "ignoreDependencies": [
    // Deliberate: pins where the vendored fonts came from. ADR 0011.
    "@ibm/plex-sans",
    // FINDING: ADR 0007 names it as the PDF parser for tests, but no test
    // imports it — the print checks use poppler instead. Removing it amends an
    // ADR, so it is the owner's call.
    "pdfjs-dist",
  ],

  "ignoreIssues": {
    // Deliberate: the shared generator catalogue from docs/testing.md §3.1.
    // Built once and reused, so some generators wait for their first caller.
    "packages/geometry/test/arbitraries.ts": ["exports"],
    // FINDING: `totalLength()` is exported from its module but not from the
    // package index, and nothing calls it.
    "packages/geometry/src/path/measure.ts": ["exports"],
    // FINDING: the `IpcChannel` type is exported and never used.
    "apps/desktop/src/shared/ipc.ts": ["types"],
  },
}
